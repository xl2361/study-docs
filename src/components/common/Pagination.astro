---
import type { Page } from "astro";
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { url } from "@/utils/url-utils";

interface Props {
	page: Page;
	class?: string;
	style?: string;
}

const { page, style } = Astro.props;

const className = Astro.props.class;

// 省略号占位符（等价 Django Paginator.ELLIPSIS）
const HIDDEN = -1;

// 页码窗口算法：移植 Django `Paginator.get_elided_page_range(number, *, on_each_side=3, on_ends=2)`
// https://github.com/django/django/blob/main/django/core/paginator.py
//
// 原实现自推"总宽固定 5 格、动态扩左右"，卡片数量在 1~5 之间浮动，
// 翻页时页码条宽度会跳动；Django 这版宽度稳定、行为有权威参照：
//   当前页两侧各 on_each_side 页 + 首尾各 on_ends 页，中间用省略号折叠。
// 例：50 页，当前第 10 页 → 1, 2, …, 8, 9, 10, 11, 12, 13, …, 49, 50
const ON_EACH_SIDE = 3;
const ON_ENDS = 2;

const numPages = page.lastPage;
const current = page.currentPage;

const elidedPageRange: number[] = [];
if (numPages <= (ON_EACH_SIDE + ON_ENDS) * 2) {
	// 页数太少，无需折叠：全部列出
	for (let i = 1; i <= numPages; i++) elidedPageRange.push(i);
} else {
	if (current > ON_EACH_SIDE + ON_ENDS + 2) {
		// 左侧折叠：首部 ON_ENDS 页 + 省略号 + 当前页往前 ON_EACH_SIDE 页
		for (let i = 1; i <= ON_ENDS; i++) elidedPageRange.push(i);
		elidedPageRange.push(HIDDEN);
		for (let i = current - ON_EACH_SIDE; i <= current; i++)
			elidedPageRange.push(i);
	} else {
		for (let i = 1; i <= current; i++) elidedPageRange.push(i);
	}

	if (current < numPages - ON_EACH_SIDE - ON_ENDS - 1) {
		// 右侧折叠：当前页往后 ON_EACH_SIDE 页 + 省略号 + 尾部 ON_ENDS 页
		for (let i = current + 1; i <= current + ON_EACH_SIDE; i++)
			elidedPageRange.push(i);
		elidedPageRange.push(HIDDEN);
		for (let i = numPages - ON_ENDS + 1; i <= numPages; i++)
			elidedPageRange.push(i);
	} else {
		for (let i = current + 1; i <= numPages; i++) elidedPageRange.push(i);
	}
}

const pages = elidedPageRange;

const getPageUrl = (p: number) => {
	if (p === 1) return "/";
	return `/${p}/`;
};
---

<div class:list={[className, "pagination-wrapper flex flex-col gap-4 items-center"]} style={style}>
  <!-- 分页控件 -->
  <div class="flex flex-row gap-3 justify-center" role="navigation" aria-label={i18n(I18nKey.postList)}>
    <!-- 移动端简化版分页 -->
    <div class="mobile-pagination flex items-center gap-3">
      <a
        href={page.url.prev || "#"}
        aria-label={i18n(I18nKey.paginationPrev)}
        aria-disabled={!page.url.prev ? "true" : "false"}
        tabindex={!page.url.prev ? "-1" : "0"}
        class:list={[
          "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
          {
            disabled: !page.url.prev,
            "opacity-50": !page.url.prev,
            "cursor-not-allowed": !page.url.prev,
          },
        ]}
      >
        <Icon is:inline
          name="material-symbols:chevron-left-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>

      <div class="btn-card flex items-center rounded-(--radius-large) px-4 h-11 gap-1.5">
        <span class="text-base font-bold text-(--primary)">{page.currentPage}</span>
        <span class="text-sm text-neutral-500 dark:text-neutral-500">/</span>
        <span class="text-base font-bold text-neutral-700 dark:text-neutral-300">{page.lastPage}</span>
      </div>

      <a
        href={page.url.next || "#"}
        aria-label={i18n(I18nKey.paginationNext)}
        aria-disabled={!page.url.next ? "true" : "false"}
        tabindex={!page.url.next ? "-1" : "0"}
        class:list={[
          "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
          {
            disabled: !page.url.next,
            "opacity-50": !page.url.next,
            "cursor-not-allowed": !page.url.next,
          },
        ]}
      >
        <Icon is:inline
          name="material-symbols:chevron-right-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>
    </div>

    <!-- 桌面端完整版分页 -->
    <div class="desktop-pagination flex items-center gap-3">
      <a
        href={page.url.prev || "#"}
        aria-label={i18n(I18nKey.paginationPrev)}
        aria-disabled={!page.url.prev ? "true" : "false"}
        tabindex={!page.url.prev ? "-1" : "0"}
        class:list={[
          "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
          {
            disabled: !page.url.prev,
            "opacity-50": !page.url.prev,
            "cursor-not-allowed": !page.url.prev,
          },
        ]}
      >
        <Icon is:inline
          name="material-symbols:chevron-left-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>
      {
        pages.map((p) => {
          if (p == HIDDEN)
            return <Icon is:inline name="material-symbols:more-horiz" class="w-11 h-11 flex items-center justify-center text-neutral-700 dark:text-neutral-300" aria-hidden="true" />;
          if (p == page.currentPage)
            return (
              <div
                class="h-11 w-11 rounded-(--radius-large) bg-(--primary) flex items-center justify-center
                        font-bold text-white dark:text-black/70"
                aria-current="page"
              >
                {p}
              </div>
            );
          return (
            <a
              href={url(getPageUrl(p))}
              aria-label={`${i18n(I18nKey.paginationPage)} ${p}`}
              class="btn-card w-11 h-11 rounded-(--radius-large) overflow-hidden active:scale-[0.85] font-bold text-neutral-700 dark:text-neutral-300"
            >
              {p}
            </a>
          );
        })
      }
      <a
        href={page.url.next || "#"}
        aria-label={i18n(I18nKey.paginationNext)}
        aria-disabled={!page.url.next ? "true" : "false"}
        tabindex={!page.url.next ? "-1" : "0"}
        class:list={[
          "btn-card overflow-hidden rounded-(--radius-large) text-(--primary) w-11 h-11",
          {
            disabled: !page.url.next,
            "opacity-50": !page.url.next,
            "cursor-not-allowed": !page.url.next,
          },
        ]}
      >
        <Icon is:inline
          name="material-symbols:chevron-right-rounded"
          class="text-[1.75rem]"
          aria-hidden="true"
        />
      </a>
    </div>
  </div>
</div>

<style>
  .pagination-wrapper {
    max-width: 100%;
  }

  .mobile-pagination {
    display: flex;
    padding: 0 1rem;
  }

  .desktop-pagination {
    display: none;
  }

  @media (min-width: 1024px) {
    .mobile-pagination {
      display: none;
    }
    .desktop-pagination {
      display: flex;
    }
  }

  @media (max-width: 640px) {
    .mobile-pagination {
      padding: 0 0.5rem;
    }
  }

  @media (max-width: 480px) {
    .mobile-pagination {
      padding: 0 0.25rem;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .mobile-pagination a,
    .mobile-pagination div {
      min-height: 44px;
      min-width: 44px;
    }
  }
</style>
