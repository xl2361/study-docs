{
	"name": "dayu-study-editor",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-04",
	"vars": {
		"ALLOWED_ORIGIN": "https://dayu-study.pages.dev",
		"GITHUB_OWNER": "xl2361",
		"GITHUB_REPO": "study-docs",
		"GITHUB_BRANCH": "master"
	},
	"ratelimits": [
		{
			"name": "LOGIN_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	}
}
