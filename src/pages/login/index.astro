<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex" />
		<title>编辑登录</title>
		<style>
			* { box-sizing: border-box; }
			body { min-height: 100vh; display: grid; place-items: center; margin: 0; padding: 1.25rem; color: #172033; background: radial-gradient(circle at 15% 10%, #dce9ff, transparent 32%), #f4f7fb; font-family: system-ui, sans-serif; }
			main { width: min(100%, 25rem); border: 1px solid #e3e8f0; border-radius: 1.25rem; padding: clamp(1.5rem, 6vw, 2.5rem); background: rgb(255 255 255 / .94); box-shadow: 0 24px 70px rgb(42 62 92 / .13); }
			h1 { margin: 0 0 .45rem; font-size: 1.8rem; }
			main > p { margin: 0 0 1.5rem; color: #718096; font-size: .88rem; }
			form { display: grid; gap: .6rem; }
			label { margin-top: .35rem; color: #334155; font-size: .82rem; font-weight: 700; }
			input { width: 100%; border: 1px solid #d9e0ea; border-radius: .75rem; padding: .78rem .9rem; color: #172033; background: #f8fafc; font: inherit; }
			input:focus { border-color: transparent; outline: 2px solid #6f9cf5; outline-offset: 2px; }
			button { margin-top: .75rem; border: 0; border-radius: .75rem; padding: .78rem; color: white; background: #527dcc; font: inherit; font-weight: 800; cursor: pointer; }
			button:disabled { cursor: wait; opacity: .65; }
			#login-error { margin: .35rem 0 0; border-radius: .6rem; padding: .55rem .7rem; color: #b43b3b; background: #fff0f0; font-size: .78rem; }
		</style>
	</head>
	<body>
		<main>
			<h1>编辑登录</h1>
			<p>登录后可在网站导航栏开启整站编辑。</p>
			<form id="login-form" method="post" action="/api/auth/login">
				<input id="next" name="next" type="hidden" value="/" />
				<label for="username">账号</label>
				<input id="username" name="username" autocomplete="username" required autofocus />
				<label for="password">密码</label>
				<input id="password" name="password" type="password" autocomplete="current-password" required />
				<button type="submit">登录</button>
				<p id="login-error" role="alert" hidden></p>
			</form>
		</main>
		<script is:inline>
			const params = new URLSearchParams(location.search);
			const next = params.get("next");
			document.getElementById("next").value = next?.startsWith("/") && !next.startsWith("//") ? next : "/";
			const error = document.getElementById("login-error");
			const message = params.get("error");
			if (message) {
				error.textContent = message;
				error.hidden = false;
			}
		</script>
	</body>
</html>
