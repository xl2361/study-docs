---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList, getSortedPostsList } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";

const categories = await getCategoryList();
const totalPosts = (await getSortedPostsList()).length;
const allUrl = url("/");
---

<MainGridLayout title={i18n(I18nKey.categories)}>
    <!-- 页面标题 -->
    <div class="card-base px-4 md:px-8 py-4 md:py-6 mb-4">
        <div class="text-xl md:text-2xl font-bold text-(--primary) mb-2">
            {i18n(I18nKey.categories)}
        </div>
        <p class="text-30 text-sm">
            {i18n(I18nKey.allCategories)} · {totalPosts} {i18n(I18nKey.postsCount)}
        </p>
    </div>

    <!-- 横排标签胶囊（拙云风格）：全部 N / 分类名 数量 -->
    <div class="card-base p-4 mb-4 onload-animation">
        <div class="flex flex-wrap gap-2 items-center justify-center">
            <a
                href={allUrl}
                class="category-pill text-sm px-4 py-1.5 rounded-full whitespace-nowrap
                       transition-colors duration-150 ease-out flex items-center justify-center"
                data-category-name=""
            >
                {i18n(I18nKey.home)}
                <span class="pill-count">{totalPosts}</span>
            </a>
            {
                categories.map((category) => (
                    <a
                        href={category.url}
                        class="category-pill text-sm px-4 py-1.5 rounded-full whitespace-nowrap
                               transition-colors duration-150 ease-out flex items-center justify-center"
                        data-category-name={category.name}
                    >
                        {category.name}
                        <span class="pill-count">{category.count}</span>
                    </a>
                ))
            }
        </div>
    </div>

    <!-- 空状态 -->
    {
        categories.length === 0 && (
            <div class="card-base px-8 py-12 text-center">
                <Icon is:inline
                    name="material-symbols:folder-off"
                    class="text-5xl text-30 mx-auto mb-4"
                />
                <p class="text-30">{i18n(I18nKey.noData)}</p>
            </div>
        )
    }
</MainGridLayout>
