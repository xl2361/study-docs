---
import FloatingButton from "@/components/common/FloatingButton.astro";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<FloatingButton
  id="back-to-top-btn"
  icon="material-symbols:keyboard-arrow-up-rounded"
  ariaLabel="Back to Top"
  onclick="backToTop()"
  class="hide" 
/>

<script is:raw is:inline>
  function backToTop() {
    // 直接使用原生滚动，避免OverlayScrollbars冲突
    window.scroll({ top: 0, behavior: "smooth" });
  }

  // 响应式返回顶部按钮管理器
  if (typeof window.BackToTopManager === "undefined") {
    window.BackToTopManager = class BackToTopManager {
      constructor() {
        this.button = document.getElementById("back-to-top-btn");
        this.init();
      }

      init() {
        if (!this.button) return; // wrapper checks removed as it is now flexible

        this.setupScrollListener();
      }

      setupScrollListener() {
        // rAF 节流：滚动事件每帧最多处理一次，避免高频回调里反复读取布局属性
        let ticking = false;
        const apply = () => {
          ticking = false;
          // 惰性解析按钮：swup 换页可能替换节点，避免持有失效引用
          const btn =
            this.button && this.button.isConnected
              ? this.button
              : document.getElementById("back-to-top-btn");
          if (!btn) return;
          this.button = btn;
          const scrollTop =
            window.pageYOffset || document.documentElement.scrollTop;

          // 当滚动超过200px时显示按钮
          if (scrollTop > 200) {
            btn.classList.remove("hide");
          } else {
            btn.classList.add("hide");
          }
        };
        const updateVisibility = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(apply);
        };

        window.addEventListener("scroll", updateVisibility, { passive: true });
      }
    };
  }
  // 只实例化一次：swup 的 SwupScriptsPlugin 每次换页都会重跑本脚本，
  // 无守卫时会反复 new，每个实例各自注册 window scroll 监听且无法移除
  // （匿名闭包），换 N 次页后每次滚动触发 N 次回调 → 越用越卡。
  if (!window.__backToTopInit) {
    window.__backToTopInit = true;
    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        () => {
          new BackToTopManager();
        },
        { once: true },
      );
    } else {
      new BackToTopManager();
    }
  }
</script>